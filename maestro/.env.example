# Copy to maestro/.env (git-ignored). One KEY=value per line, no quotes needed; run.sh passes
# them to Maestro as -e. Empty values are left out.
WALLET_APP_ID=com.example.wallet
WALLET_NAME=Example Wallet
WALLET_VERSION=
# The wallet's own PIN, entered when it asks to confirm. Leave out if it does not ask.
WALLET_PIN=111111
# Wallet QA; for a hosted instance also QA_USER and QA_PASSWORD (the team login).
QA_URL=http://127.0.0.1:8787
QA_USER=
QA_PASSWORD=
