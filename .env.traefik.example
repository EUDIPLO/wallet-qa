# Hosted Wallet QA behind an existing Traefik (docs/hosting.md). Copy to .env.traefik on the
# server and fill in.

# Public hostnames, routed by your Traefik.
QA_HOST=conformance.eudiplo.dev
EUDIPLO_HOST=issuer.conformance.eudiplo.dev

# Your Traefik: external Docker network, HTTPS entrypoint and certificate resolver.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Basic auth for the Wallet QA page and API (one shared login for the team). A bcrypt hash:
#   htpasswd -nbB qa '<password>' | cut -d: -f2
# or: docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext '<password>'
# Keep the single quotes: the hash contains `$`.
QA_AUTH_USER=qa
QA_AUTH_HASH=''

# Output of `pnpm fixtures:generate $EUDIPLO_HOST <dir>` plus your own overlay files,
# kept on the server, never in git.
QA_FIXTURES_DIR=/srv/wallet-qa/fixtures

# EUDIPLO secrets. Generate each with: openssl rand -hex 32
EUDIPLO_MASTER_SECRET=
EUDIPLO_ADMIN_CLIENT_SECRET=

# Tag of the published images ghcr.io/eudiplo/wallet-qa and wallet-qa-eudiplo: `main` (every
# push to main), `sha-<commit>` or a release such as `1.2.3`.
WALLET_QA_TAG=main
# Only used when you build the images on the server (`up --build`): the EUDIPLO base image tag.
# The published wallet-qa-eudiplo image is built on EUDIPLO `main`.
EUDIPLO_VERSION=main
# Finished runs and idle workspaces stay for this long, then Wallet QA deletes them.
QA_RETENTION_HOURS=168
