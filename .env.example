# Copy to .env, fill the two EUDIPLO secrets, then: docker compose -p wallet-qa up --build -d --wait
# If port 3000 is taken: EUDIPLO_HOST_PORT=3010 and EUDIPLO_BASE_URL=http://localhost:3010
# Wallet-facing origins. Caddy terminates HTTPS on these ports (see deploy/Caddyfile).
PUBLIC_ORIGIN=https://localhost:8443
REDIRECT_URI=https://localhost:8443/r/{sessionId}
EUDIPLO_PUBLIC_URL=https://localhost:3443
# Internal EUDIPLO address for `pnpm dev` / `pnpm smoke` on the host; Compose overrides it.
EUDIPLO_BASE_URL=http://localhost:3000

# Profiles map each scenario step to an EUDIPLO tenant.
QA_BACKENDS_FILE=config/eudiplo-backends.json
EUDIPLO_VERSION=main
EUDIPLO_CONFIG_SOURCE=eudiplo-config

# Finished runs and idle workspaces stay for this long, then Wallet QA deletes them and their EUDIPLO sessions.
QA_RETENTION_HOURS=168
QA_DATA_FILE=data/runs.json

# EUDIPLO container secrets. Generate with: openssl rand -hex 32
EUDIPLO_MASTER_SECRET=replace-with-random-secret-at-least-32-characters
EUDIPLO_ADMIN_CLIENT_SECRET=replace-with-random-admin-secret

# Removes published results (DELETE /v1/published/<id> with "Authorization: Bearer <token>").
# Unset: published results can only be removed by editing data/published.json. Generate with: openssl rand -hex 32
QA_ADMIN_TOKEN=
# At most this many published results are kept; further publishes are refused until some are removed.
QA_PUBLISHED_MAX=1000
