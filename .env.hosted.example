# Hosted Wallet QA (docs/hosting.md). Copy to .env.hosted on the server and fill in.

# Public hostnames; both must resolve to this server, ports 80 and 443 open.
QA_HOST=conformance.eudiplo.dev
EUDIPLO_HOST=issuer.conformance.eudiplo.dev
# Contact for Let's Encrypt expiry notices.
ACME_EMAIL=

# Basic auth for the Wallet QA page and API (one shared login for the team). Create the hash
# with: docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext '<password>'
# Keep the single quotes: the hash contains `$`.
QA_AUTH_USER=qa
QA_AUTH_HASH=''

# Output of `pnpm fixtures:generate $EUDIPLO_HOST <dir>`, kept on the server, never in git.
# Its overlay/ holds what this deployment changes in the tenant config (docs/hosting.md).
QA_FIXTURES_DIR=/srv/wallet-qa/fixtures

# EUDIPLO secrets. Generate each with: openssl rand -hex 32
EUDIPLO_MASTER_SECRET=
EUDIPLO_ADMIN_CLIENT_SECRET=

EUDIPLO_VERSION=main
# Finished runs and idle workspaces stay for this long, then Wallet QA deletes them.
QA_RETENTION_HOURS=168
