+
+/**
+ * Wallet QA test build only: certificate chain trust that accepts chains ending in a Wallet QA
+ * test root in addition to the EU lists of trusted entities (LoTE).
+ *
+ * Wallet Core builds its ETSI trust source internally and does not expose it, so this class builds
+ * the same pipeline as Wallet Core 0.32.0's `EtsiTrustProvider` (with the dev flavor's settings:
+ * relaxed certificate profiles, revocation checks disabled) and puts a static check in front of
+ * it. A chain is trusted when it validates (PKIX) against one of [walletQaRoots]; otherwise the
+ * EU lists decide, exactly as without this class. Nothing is disabled: untrusted chains are still
+ * rejected, and requests signed by any other root still fail.
+ */
+internal class WalletQaTrust(
+    context: Context,
+    walletQaRoots: List<X509Certificate>,
+    loteLocations: SupportedLists<Uri>,
+    loteSignerTrustAnchors: List<X509Certificate>,
+) {
+    private val disposableContainer = DisposableContainer()
+
+    private val pkixNoRevocation = ValidateCertificateChainUsingPKIXJvm(
+        customization = { isRevocationEnabled = false }
+    )
+
+    private val etsi: IsChainTrustedForEUDIW<List<X509Certificate>, TrustAnchor> = run {
+        val loadLoTE = LoadSingleLoTEWithFileCache(
+            // Separate from Wallet Core's "lote-cache" so the two pipelines never share files.
+            cacheDirectory = Path(context.cacheDir.path, "wallet-qa-lote-cache"),
+            downloadSingleLoTE = DownloadSingleLoTE(HttpClient()),
+            fileCacheExpiration = 24.hours,
+        )
+        val loadLoTEAndPointers = LoadLoTEAndPointers(
+            constraints = LoadLoTEAndPointers.Constraints.DoNotLoadOtherPointers,
+            verifyJwtSignature = LoteJwtSignature(
+                signerTrustAnchors = NonEmptyList(loteSignerTrustAnchors.map { TrustAnchor(it, null) }),
+                validateSigner = ValidateCertificateChainUsingDirectTrustJvm or pkixNoRevocation,
+            ),
+            loadLoTE = loadLoTE,
+        )
+        ProvisionTrustAnchorsFromLoTEs.eudiwJvm(
+            loadLoTEAndPointers = loadLoTEAndPointers,
+            svcTypePerCtx = relaxProfiles(SupportedLists.eu()),
+            pkix = pkixNoRevocation,
+        ).cached(disposableContainer, loteLocations, ttl = 20.minutes)
+    }
+
+    private val walletQaAnchors = NonEmptyList(walletQaRoots.map { TrustAnchor(it, null) })
+    private val walletQaRootSet = walletQaRoots.toSet()
+
+    /** Wallet QA roots first, then the EU lists. Use for issuer, metadata and reader trust. */
+    val isChainTrusted: IsChainTrustedForEUDIW<List<X509Certificate>, TrustAnchor> =
+        IsChainTrustedForContextF { chain, verificationContext ->
+            // The x5c chains Wallet QA sends may end with the root itself; PKIX expects the path
+            // without its trust anchor.
+            val path = chain.filterNot { it in walletQaRootSet }
+            val local = if (path.isEmpty()) null else pkixNoRevocation(path, walletQaAnchors)
+            if (local is CertificationChainValidation.Trusted) {
+                Log.d(TAG, "Trusted by a Wallet QA root: $verificationContext")
+                local
+            } else {
+                val listed = etsi(chain, verificationContext)
+                Log.d(TAG, "Not a Wallet QA chain; EU lists say ${listed?.javaClass?.simpleName}: $verificationContext")
+                listed ?: local
+            }
+        }
+
+    private companion object {
+        const val TAG = "WalletQaTrust"
+
+        fun relaxProfiles(
+            eu: SupportedLists<LotEMeta<VerificationContext>>,
+        ): SupportedLists<LotEMeta<VerificationContext>> {
+            fun LotEMeta<VerificationContext>.relax() = copy(
+                svcTypePerCtx = svcTypePerCtx.mapValues { (_, v) -> v.copy(endEntityProfile = null) }
+            )
+            return eu.copy(
+                pidProviders = eu.pidProviders?.relax(),
+                walletProviders = eu.walletProviders?.relax(),
+                wrpacProviders = eu.wrpacProviders?.relax(),
+                wrprcProviders = eu.wrprcProviders?.relax(),
+                pubEaaProviders = eu.pubEaaProviders?.relax(),
+                qeaProviders = eu.qeaProviders?.relax(),
+                eaaProviders = eu.eaaProviders.mapValues { (_, v) -> v.relax() },
+            )
+        }
+    }
+}
+
+/** Same as Wallet Core 0.32.0's internal `LoteJwtVerifier`: verifies a LoTE JWT signed by an x5c chain. */
+private class LoteJwtSignature(
+    private val signerTrustAnchors: NonEmptyList<TrustAnchor>,
+    private val validateSigner: ValidateCertificateChain<List<X509Certificate>, TrustAnchor>,
+) : VerifyJwtSignature {
+    override suspend fun invoke(jwt: String): VerifyJwtSignature.Outcome = try {
+        val signedJwt = SignedJWT.parse(jwt)
+        val x5c = signedJwt.header.x509CertChain
+        if (x5c.isNullOrEmpty()) {
+            VerifyJwtSignature.Outcome.NotVerified(IllegalArgumentException("JWT header has no x5c chain"))
+        } else {
+            val factory = CertificateFactory.getInstance("X.509")
+            val chain = x5c.map {
+                factory.generateCertificate(ByteArrayInputStream(it.decode())) as X509Certificate
+            }
+            val signer = chain.first().apply { checkValidity() }
+            when (val validation = validateSigner(chain, signerTrustAnchors)) {
+                is CertificationChainValidation.NotTrusted ->
+                    VerifyJwtSignature.Outcome.NotVerified(validation.cause)
+
+                is CertificationChainValidation.Trusted -> {
+                    val verifier: JWSVerifier? = when (val key = signer.publicKey) {
+                        is ECPublicKey -> ECDSAVerifier(key)
+                        is RSAPublicKey -> RSASSAVerifier(key)
+                        else -> null
+                    }
+                    when {
+                        verifier == null -> VerifyJwtSignature.Outcome.NotVerified(
+                            UnsupportedOperationException("Unsupported key type: ${signer.publicKey.algorithm}")
+                        )
+                        signedJwt.verify(verifier) -> VerifyJwtSignature.Outcome.Verified(jwt)
+                        else -> VerifyJwtSignature.Outcome.NotVerified(SecurityException("JWT signature verification failed"))
+                    }
+                }
+            }
+        }
+    } catch (e: CancellationException) {
+        throw e
+    } catch (@Suppress("TooGenericExceptionCaught") e: Exception) {
+        VerifyJwtSignature.Outcome.NotVerified(e)
+    }
+}
