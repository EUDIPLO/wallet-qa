          "format": "dc+sd-jwt",
          "meta": {
            "vct_values": [
              "urn:eudi:eaa:event-access-attestation:1"
            ]
          },
          "claims": [
            {
              "path": [
                "event_name"
              ]
            }
          ]
        }
      ],
      "credential_sets": [
        {
          "options": [
            [
              "card"
            ],
            [
              "event-access-attestation"
            ]
          ]
        }
      ]
    },
